# Base URL at which THIS SAME backend is reachable, used by the simulated
# gateway to call its own webhook (App\Support\Clock and the gateway client
# both read this).
APP_BASE_URL=http://localhost:8080

# Optional: force every gateway response for the whole app instance, one of
# aprobado | rechazado | timeout. Leave empty to use the random 60/30/10 split.
# Can also be overridden per-request, see README.
GATEWAY_FORCE_RESULT=
